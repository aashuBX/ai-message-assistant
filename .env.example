# Copy to .env (git-ignored); never commit a real key.
# Free Groq API key (practice project, not production): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model ID and endpoint
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_REASONING_EFFORT=low     # low | medium | high; low = fewer billed tokens
